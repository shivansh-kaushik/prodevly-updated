{
  "name": "prodevly-website",
  "version": "0.1.0",
  "private": true,
  "description": "ProDevly company site and admin panel.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/copy-gpu-benchmarks.mjs",
    "dev": "next dev -p 3050",
    "prebuild": "node scripts/copy-gpu-benchmarks.mjs",
    "build": "next build",
    "start": "next start -p 3050",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:copy": "node scripts/check-public-copy.mjs",
    "check:stacking": "node scripts/check-stacking.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "audit:boundaries": "node scripts/audit-boundaries.mjs",
    "verify": "npm run lint && npm run check:copy && npm run check:stacking && npm run check:contrast && npm run audit:boundaries && npm run audit:filters && npm run typecheck && npm test && npm run build",
    "dev:db": "tsx scripts/dev-db.ts",
    "seed": "tsx scripts/seed.ts",
    "db:indexes": "tsx scripts/db-indexes.ts",
    "admin:reset-password": "tsx scripts/reset-password.ts",
    "audit:filters": "node scripts/audit-filters.mjs",
    "smoke": "tsx scripts/smoke.ts",
    "check:stage": "tsx scripts/check-stage.ts",
    "check:home": "tsx scripts/check-home.ts",
    "posters": "tsx scripts/posters.ts",
    "reset:rate-limits": "tsx scripts/reset-rate-limits.ts",
    "fx:fetch": "tsx scripts/fx-fetch.ts"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@gsap/react": "2.1.2",
    "@pmndrs/detect-gpu": "6.0.26",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "bcryptjs": "3.0.3",
    "gsap": "3.15.0",
    "jose": "6.2.12",
    "lenis": "1.3.26",
    "lucide-react": "1.55.0",
    "mongoose": "9.11.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "three": "0.186.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@next/env": "16.4.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.2.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "mongodb-memory-server": "11.3.0",
    "tailwindcss": "4.2.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
